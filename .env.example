# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Claude API (set a spending cap on this key in the Claude Console)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=60

# Postgres (used by the postgres container and by DATABASE_URL)
POSTGRES_USER=jobfit
POSTGRES_PASSWORD=jobfit
POSTGRES_DB=jobfit
DATABASE_URL=postgresql+psycopg://jobfit:jobfit@postgres:5432/jobfit

# RabbitMQ
BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Local embeddings (vector size 384; change the migration if you change the model)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cost guard
DAILY_ANALYSIS_LIMIT=20
